rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.uid == '8LGxmtgTk0Z7Ad6ofDLobg36Nh73';
    }

    function isValidFeedbackSubmission() {
      return request.resource.data.keys().hasAll([
          'name',
          'role',
          'message',
          'status',
          'submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'role',
          'message',
          'status',
          'submittedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.role is string
        && request.resource.data.role.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time;
    }

    match /draftContent/{sectionId} {
      allow read, write: if isPortfolioAdmin();
    }

    match /draftProjects/{projectId} {
      allow read, write: if isPortfolioAdmin();
    }

    match /draftExperience/{experienceId} {
      allow read, write: if isPortfolioAdmin();
    }

    match /draftAchievements/{achievementId} {
      allow read, write: if isPortfolioAdmin();
    }

    match /draftMemories/{memoryId} {
      allow read, write: if isPortfolioAdmin();
    }

    match /draftLessons/{lessonId} {
      allow read, write: if isPortfolioAdmin();
    }

    match /draftHighlights/{highlightId} {
      allow read, write: if isPortfolioAdmin();
    }

    match /publicContent/{sectionId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();
    }

    match /publicProjects/{projectId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();
    }

    match /publicExperience/{experienceId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();
    }

    match /publicAchievements/{achievementId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();
    }

    match /publicMemories/{memoryId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();
    }

    match /publicLessons/{lessonId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();
    }

    match /publicHighlights/{highlightId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();
    }

    match /siteImages/{imageId} {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasAll([
          'dataUrl',
          'mimeType',
          'width',
          'height',
          'sizeBytes',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'dataUrl',
          'mimeType',
          'width',
          'height',
          'sizeBytes',
          'createdAt'
        ])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 250000
        && request.resource.data.mimeType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isPortfolioAdmin();
    }

    match /feedbackInbox/{feedbackId} {
      allow create: if isValidFeedbackSubmission();
      allow read, update, delete: if isPortfolioAdmin();
    }

    match /publicFeedback/{feedbackId} {
      allow read: if true;
      allow write: if isPortfolioAdmin();

      match /likes/{userId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && exists(
            /databases/$(database)/documents/publicFeedback/$(feedbackId)
          )
          && get(
            /databases/$(database)/documents/publicFeedback/$(feedbackId)
          ).data.get('likesDisabled', false) == false
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isPortfolioAdmin()
          || (request.auth != null && request.auth.uid == userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
